<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_pos_config_form_thermal_receipt" model="ir.ui.view">
        <field name="name">pos.config.form.thermal.receipt.80mm</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Ticket térmico 80 mm">
                    <field name="thermal_receipt_commercial_name"/>
                    <field name="thermal_receipt_address"/>
                    <field name="thermal_receipt_phone"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
