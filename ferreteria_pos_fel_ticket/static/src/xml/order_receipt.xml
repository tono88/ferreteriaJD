<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="ferreteria_pos_fel_ticket.OrderReceipt"
       t-inherit="point_of_sale.OrderReceipt"
       t-inherit-mode="extension">

        <xpath expr="//ReceiptHeader" position="replace">
            <t t-if="props.data.fel_ticket and props.data.fel_ticket.enabled">
                <div class="ferreteria-fel-header">
                    <img t-if="props.data.fel_ticket.company_logo_url"
                         t-att-src="props.data.fel_ticket.company_logo_url"
                         class="ferreteria-fel-logo"
                         alt="Logo"/>
                    <div class="fw-bolder" t-esc="props.data.fel_ticket.commercial_name"/>
                    <div t-if="props.data.fel_ticket.emitter_name != props.data.fel_ticket.commercial_name"
                         t-esc="props.data.fel_ticket.emitter_name"/>
                    <div>NIT: <t t-esc="props.data.fel_ticket.emitter_vat or ''"/></div>
                    <div t-if="props.data.fel_ticket.emitter_address"
                         t-esc="props.data.fel_ticket.emitter_address"/>
                    <div t-if="props.data.fel_ticket.emitter_phone">
                        Tel: <t t-esc="props.data.fel_ticket.emitter_phone"/>
                    </div>
                    <div t-if="props.data.fel_ticket.receipt_header"
                         class="ferreteria-fel-preline mt-1"
                         t-esc="props.data.fel_ticket.receipt_header"/>
                </div>
            </t>
            <t t-else="">
                <ReceiptHeader data="props.data.headerData"/>
            </t>
        </xpath>

        <xpath expr="//OrderWidget" position="before">
            <div t-if="props.data.fel_ticket and props.data.fel_ticket.enabled"
                 class="ferreteria-fel-document-data">
                <t t-if="props.data.fel_ticket.is_fel">
                    <div class="text-center fw-bolder">DOCUMENTO TRIBUTARIO ELECTRÓNICO FEL</div>
                    <div class="text-center fw-bolder" t-esc="props.data.fel_ticket.document_type"/>
                    <div t-if="props.data.fel_ticket.certified" class="mt-1">
                        <div>Tipo DTE: <t t-esc="props.data.fel_ticket.document_type_code or ''"/></div>
                        <div>Serie DTE: <t t-esc="props.data.fel_ticket.series or ''"/></div>
                        <div>Número DTE: <t t-esc="props.data.fel_ticket.number or ''"/></div>
                    </div>
                    <div t-else="" class="ferreteria-fel-pending mt-1">
                        PENDIENTE DE CERTIFICACIÓN FEL
                    </div>
                </t>
                <t t-else="">
                    <div class="text-center fw-bolder">COMPROBANTE INTERNO DE VENTA</div>
                    <div class="ferreteria-fel-pending">NO ES DTE CERTIFICADO</div>
                </t>
                <div t-if="props.data.fel_ticket.document_status"
                     class="ferreteria-ticket-status mt-1"
                     t-esc="props.data.fel_ticket.document_status"/>
                <div class="mt-1">Fecha: <t t-esc="props.data.fel_ticket.issue_datetime or props.data.date"/></div>
                <div class="fw-bolder">Serie interna: <t t-esc="props.data.fel_ticket.internal_series or '-'"/></div>
                <div class="fw-bolder">No. interno: <t t-esc="props.data.fel_ticket.internal_number or props.data.fel_ticket.internal_correlative or 'No asignado'"/></div>
                <div t-if="props.data.fel_ticket.cashier">Cajero: <t t-esc="props.data.fel_ticket.cashier"/></div>
                <div t-if="props.data.fel_ticket.pos_name">Punto de venta: <t t-esc="props.data.fel_ticket.pos_name"/></div>
                <div class="ferreteria-fel-separator">--------------------------------</div>
                <div>NIT cliente: <t t-esc="props.data.fel_ticket.customer_vat or 'CF'"/></div>
                <div>Cliente: <t t-esc="props.data.fel_ticket.customer_name or 'Consumidor Final'"/></div>
                <div t-if="props.data.fel_ticket.customer_address">
                    Dirección: <t t-esc="props.data.fel_ticket.customer_address"/>
                </div>
                <div class="ferreteria-fel-separator">--------------------------------</div>
            </div>
        </xpath>

        <xpath expr="//OrderWidget" position="replace">
            <t t-if="props.data.fel_ticket and props.data.fel_ticket.enabled">
                <div class="ferreteria-ticket-lines">
                    <div t-foreach="props.data.fel_ticket.lines or []"
                         t-as="line"
                         t-key="line_index"
                         class="ferreteria-ticket-line">
                        <div class="ferreteria-ticket-line-name" t-esc="line.name"/>
                        <div class="ferreteria-ticket-line-values">
                            <span class="ferreteria-ticket-line-calculation">
                                <t t-esc="line.quantity_display"/>
                                <t t-if="line.unit_name"> <t t-esc="line.unit_name"/></t>
                                × <t t-esc="line.unit_price_formatted"/>
                            </span>
                            <span class="ferreteria-ticket-line-subtotal"
                                  t-esc="line.line_total_formatted"/>
                        </div>
                        <div t-if="line.discount"
                             class="ferreteria-ticket-line-discount">
                            Descuento: <t t-esc="line.discount_display"/>%
                        </div>
                        <div t-if="line.customer_note"
                             class="ferreteria-ticket-line-note"
                             t-esc="line.customer_note"/>
                    </div>
                </div>
                <div class="ferreteria-ticket-grand-total">
                    <span>TOTAL:</span>
                    <span class="ferreteria-ticket-grand-total-amount"
                          t-esc="props.formatCurrency(props.data.amount_total)"/>
                </div>
            </t>
            <t t-else="">
                <OrderWidget t-if="props.data.orderlines?.length"
                             lines="props.data.orderlines"
                             t-slot-scope="scope"
                             generalNote="props.data.generalNote or ''"
                             screenName="props.data.screenName">
                    <t t-set="line" t-value="scope.line"/>
                    <Orderline basic_receipt="props.basic_receipt"
                               line="omit(scope.line, 'customerNote')"
                               class="{ 'px-0': true }"
                               showTaxGroupLabels="showTaxGroupLabels">
                        <li t-if="line.customerNote"
                            class="customer-note w-100 p-2 my-1 rounded text-break">
                            <i class="fa fa-sticky-note me-1"
                               role="img"
                               aria-label="Customer Note"
                               title="Customer Note"/>
                            <t t-esc="line.customerNote"/>
                        </li>
                    </Orderline>
                </OrderWidget>
            </t>
        </xpath>

        <xpath expr="//div[contains(concat(' ', normalize-space(@class), ' '), ' receipt-total ')]"
               position="attributes">
            <attribute name="t-if">not (props.data.fel_ticket and props.data.fel_ticket.enabled)</attribute>
        </xpath>

        <xpath expr="//div[@class='before-footer']" position="replace">
            <div class="before-footer"/>
            <div t-if="props.data.fel_ticket and props.data.fel_ticket.enabled"
                 class="ferreteria-fel-certification">
                <div class="ferreteria-fel-separator">--------------------------------</div>
                <t t-if="props.data.fel_ticket.is_fel">
                    <t t-if="props.data.fel_ticket.certified">
                        <div class="ferreteria-fel-break">
                            Autorización/UUID: <t t-esc="props.data.fel_ticket.authorization"/>
                        </div>
                        <div t-if="props.data.fel_ticket.certification_datetime">
                            Fecha/hora certificación: <t t-esc="props.data.fel_ticket.certification_datetime"/>
                        </div>
                    </t>
                    <div t-else="" t-esc="props.data.fel_ticket.message" class="ferreteria-fel-pending"/>
                    <div t-if="props.data.fel_ticket.certifier_name" class="mt-1">
                        Certificador: <t t-esc="props.data.fel_ticket.certifier_name"/>
                    </div>
                    <div t-if="props.data.fel_ticket.certifier_vat">
                        NIT certificador: <t t-esc="props.data.fel_ticket.certifier_vat"/>
                    </div>
                    <div t-if="props.data.fel_ticket.qr_image_src" class="text-center mt-2">
                        <img t-att-src="props.data.fel_ticket.qr_image_src"
                             class="ferreteria-fel-qr"
                             alt="QR FEL"/>
                    </div>
                </t>
                <div t-else="" class="ferreteria-fel-pending" t-esc="props.data.fel_ticket.message"/>
                <div class="ferreteria-required-legends text-center mt-2">
                    <div>TODO MATERIAL SERÁ DESCARGADO A PIE DE CAMIÓN</div>
                    <div>Sujeto a pagos trimestrales ISR</div>
                    <div>Agente de Retención del IVA</div>
                </div>
                <div t-if="props.data.fel_ticket.receipt_footer"
                     class="ferreteria-fel-preline text-center mt-2"
                     t-esc="props.data.fel_ticket.receipt_footer"/>
            </div>
        </xpath>
    </t>
</templates>
