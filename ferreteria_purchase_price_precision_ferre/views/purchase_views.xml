<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_price_precision_ferre" model="ir.ui.view">
        <field name="name">purchase.order.form.price.precision.ferre</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//field[@name='price_unit']" position="attributes">
                <attribute name="widget">ferreteria_purchase_price_8</attribute>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_line_tree_price_precision_ferre" model="ir.ui.view">
        <field name="name">purchase.order.line.list.price.precision.ferre</field>
        <field name="model">purchase.order.line</field>
        <field name="inherit_id" ref="purchase.purchase_order_line_tree"/>
        <field name="arch" type="xml">
            <field name="price_unit" position="attributes">
                <attribute name="widget">ferreteria_purchase_price_8</attribute>
            </field>
        </field>
    </record>

    <record id="purchase_order_line_form_price_precision_ferre" model="ir.ui.view">
        <field name="name">purchase.order.line.form.price.precision.ferre</field>
        <field name="model">purchase.order.line</field>
        <field name="inherit_id" ref="purchase.purchase_order_line_form2"/>
        <field name="arch" type="xml">
            <field name="price_unit" position="attributes">
                <attribute name="widget">ferreteria_purchase_price_8</attribute>
            </field>
        </field>
    </record>

    <record id="purchase_history_tree_price_precision_ferre" model="ir.ui.view">
        <field name="name">purchase.history.list.price.precision.ferre</field>
        <field name="model">purchase.order.line</field>
        <field name="inherit_id" ref="purchase.purchase_history_tree"/>
        <field name="arch" type="xml">
            <field name="price_unit" position="attributes">
                <attribute name="widget">ferreteria_purchase_price_8</attribute>
            </field>
        </field>
    </record>
</odoo>

