<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form_ferreteria_cotizaciones" model="ir.ui.view">
        <field name="name">res.config.settings.pos.ferreteria.cotizaciones</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_interface_section']" position="inside">
                <setting help="Crear y gestionar cotizaciones desde el punto de venta." invisible="is_kiosk_mode">
                    <field name="pos_create_so"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
