<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="ferreteria_pos_cotizaciones.ControlButtons"
       t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//t[@t-if='props.showRemainingButtons']/div/OrderlineNoteButton[last()]" position="after">
            <button t-if="pos.config.create_so"
                    class="btn btn-secondary btn-lg py-5"
                    t-on-click="() => this.clickCreateFerreteriaQuotation()">
                <i class="fa fa-file-text-o me-2" aria-hidden="true"/>
                Crear cotización
            </button>
        </xpath>
    </t>
</templates>
