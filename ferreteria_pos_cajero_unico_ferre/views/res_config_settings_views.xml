<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form_ferreteria_cajero_unico" model="ir.ui.view">
        <field name="name">res.config.settings.pos.ferreteria.cajero.unico</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_interface_section']" position="inside">
                <setting string="Cajero único según cuenta de Odoo"
                         help="Usa el empleado vinculado a la cuenta autenticada. "
                         id="ferreteria_cajero_unico">
                    <field name="pos_ferreteria_cajero_unico"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
